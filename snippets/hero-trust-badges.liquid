{% comment %}
  Renders trust badges for the Hero section.
  Accepts:
  - section: {Object} Section object containing blocks
  - wrapper_class: {String} Class name for the container ('badges' or 'badgestrip')
{% endcomment %}

<div class="{{ wrapper_class }}">
  {%- for block in section.blocks -%}
    {%- if block.type == 'trust_badge' -%}
      <div class="badge" {{ block.shopify_attributes }}>
        <span class="badge-icon svg-wrapper">
          {%- case block.settings.icon -%}
            {%- when 'leaf' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon icon-leaf">
                <path d="M18 2C18 2 11 2 7 6C3 10 3 17 3 17C3 17 10 17 14 13C18 9 18 2 18 2Z"/>
                <path d="M3 17L9 11"/>
              </svg>
            {%- when 'shield' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon icon-shield">
                <path d="M10 2L3 5V10C3 14.5 6 18.5 10 20C14 18.5 17 14.5 17 10V5L10 2Z"/>
                <path d="M7 10L9 12L13 8"/>
              </svg>
            {%- when 'sparkle' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon icon-sparkle">
                <path d="M10 2L12.2 7.8L18 10L12.2 12.2L10 18L7.8 12.2L2 10L7.8 7.8L10 2Z"/>
              </svg>
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon icon-leaf">
                <path d="M18 2C18 2 11 2 7 6C3 10 3 17 3 17C3 17 10 17 14 13C18 9 18 2 18 2Z"/>
                <path d="M3 17L9 11"/>
              </svg>
          {%- endcase -%}
        </span>
        <span class="badge-text">
          <span class="badge-line badge-line-1">{{ block.settings.line_1 | escape }}</span>
          <span class="badge-line badge-line-2">{{ block.settings.line_2 | escape }}</span>
        </span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
